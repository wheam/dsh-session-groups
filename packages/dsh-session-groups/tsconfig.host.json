{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/spec.ts",
    "src/types.ts"
  ]
}
